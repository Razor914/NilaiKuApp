<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_header_blue"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Input Nilai Siswa"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masukkan nilai tugas, UTS, dan UAS"
                android:textColor="#E0ECFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-48dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cari Data Siswa"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNisInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan NIS"
                    android:inputType="text"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@android:drawable/edit_text" />

                <Button
                    android:id="@+id/btnCariSiswa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cari Siswa"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtDataSiswa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data siswa belum dipilih"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Form Nilai"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNilaiTugas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nilai Tugas"
                    android:inputType="number"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@android:drawable/edit_text" />

                <EditText
                    android:id="@+id/edtNilaiUts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nilai UTS"
                    android:inputType="number"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:drawable/edit_text" />

                <EditText
                    android:id="@+id/edtNilaiUas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nilai UAS"
                    android:inputType="number"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:drawable/edit_text" />

                <TextView
                    android:id="@+id/txtHasilNilai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nilai akhir akan muncul setelah disimpan"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp" />

                <Button
                    android:id="@+id/btnSimpanNilai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simpan Nilai"
                    android:layout_marginTop="18dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
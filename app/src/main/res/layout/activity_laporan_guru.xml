<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_header_blue"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laporan Nilai Guru"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInfoGuruLaporan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat data guru..."
            android:textColor="#E0ECFF"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-38dp"
        card_view:cardCornerRadius="18dp"
        card_view:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtRingkasanLaporanGuru"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memuat laporan..."
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInfoLaporanGuru"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data nilai akan tampil di bawah"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnCetakPdfGuru"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_pdf"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="Cetak Laporan PDF"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLaporanGuru"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp" />

    <EditText
        android:id="@+id/edtCariNilaiGuru"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@android:drawable/edit_text"
        android:hint="Cari berdasarkan nama, NIS, kelas, atau status"
        android:inputType="text"
        android:padding="12dp" />

</LinearLayout>